# Copy to backend/.env for local runs: cp .env.example .env

# LMS REST API — browser portals use ngrok; Python uses LMS_API_LOCAL_FALLBACK on same laptop.
LMS_API_BASE=https://unmixed-virtual-chihuahua.ngrok-free.dev
LMS_API_LOCAL_FALLBACK=http://localhost:9090
# Or point directly: LMS_API_BASE=http://localhost:9090

# Redis — required for LMS-integrated live attendance marks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Comma-separated extra CORS origins (localhost + LAN + ngrok are matched by default regex).
CORS_ORIGINS=https://blubber-dress-startle.ngrok-free.dev

# Optional: standalone ai-attendance frontend (Vercel)
# FRONTEND_URL=https://your-app.vercel.app

# Optional: override default regex (Vercel + ngrok + LAN dev)
# CORS_ORIGIN_REGEX=...

# ML feature flags (default: enabled). Set to false to skip loading/inference.
ENABLE_ANTI_SPOOF=true
ENABLE_LOCATION_DETECTION=false
# Defer spoof + location checks until after teacher submits session (faster live marking).
DEFER_ML_REVIEW=true