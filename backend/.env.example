# Copy to backend/.env for local runs (optional; also export in shell)

# Your Vercel app URL (production). Comma-separate multiple origins if needed.
FRONTEND_URL=https://your-app.vercel.app

# Extra CORS origins (comma-separated), e.g. custom domain
# CORS_ORIGINS=https://attendance.example.com

# Preview + production Vercel subdomains are allowed by default via regex.
# Override only if you use a non-vercel.app host:
# CORS_ORIGIN_REGEX=https://.*\.example\.com
