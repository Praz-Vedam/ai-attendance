# Copy to backend/.env for local runs: cp .env.example .env

# LMS REST API — browser portals use ngrok; Python uses LMS_API_LOCAL_FALLBACK on same laptop.
LMS_API_BASE=https://unmixed-virtual-chihuahua.ngrok-free.dev
LMS_API_LOCAL_FALLBACK=http://localhost:9090
# Or point directly: LMS_API_BASE=http://localhost:9090

# Redis — required for LMS-integrated live attendance marks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Comma-separated extra CORS origins (localhost:3000 is allowed by default).
# ngrok FE tunnels are also matched automatically via CORS_ORIGIN_REGEX below.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,http://192.168.20.72:3003,https://blubber-dress-startle.ngrok-free.dev

# Optional: standalone ai-attendance frontend (Vercel)
# FRONTEND_URL=https://your-app.vercel.app

# Optional: override default regex (Vercel + ngrok)
# CORS_ORIGIN_REGEX=https://(.*\.vercel\.app|.*\.ngrok-free\.(dev|app))