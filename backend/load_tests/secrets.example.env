# Copy to load_tests/secrets.env (gitignored)
#
# Minimum setup: 1 teacher + 1 student token (access or refresh).
# Paste from DevTools → Application → Cookies → localhost
#   accessToken  → LOAD_TEST_*_ACCESS_TOKEN
#   refreshToken → LOAD_TEST_*_REFRESH_TOKEN  (auto-refreshed before each run)
#
# Log into admin portal first, copy teacher token. Then student portal, copy student token.

LOAD_TEST_TEACHER_ACCESS_TOKEN=
LOAD_TEST_STUDENT_ACCESS_TOKEN=

# Or use refresh tokens (refreshed automatically if access token is empty/expired)
# LOAD_TEST_TEACHER_REFRESH_TOKEN=
# LOAD_TEST_STUDENT_REFRESH_TOKEN=

# Class session to simulate (required for mark test)
CLASS_SESSION_ID=12345

# Target server (default local). Use your hosted Python API URL to load-test remote:
# LOCUST_HOST=https://attendance.vedam.org

# Polling test: replicate 1 student token for N concurrent users (default 150)
# LOAD_TEST_STUDENT_TOKEN_COPIES=150

# Mark test: POST /lms/attendance/mark (face-api embedding + JPEG; spoof/location deferred)
# Embeddings are auto-fetched from LMS into load_tests/student_embeddings.json.
# Manual fallback for a single enrolled student:
# FACE_EMBEDDING_JSON=[0.12,-0.03,...]
# Mark burst test (default: 150 polling + 150 marking; Locust spawns 300 total)
# LOCUST_USERS=150
# MARK_USERS=150
# POLL_USERS=150
# MARK_WINDOW_SECONDS=15
# MARK_DISTRIBUTION=burst     # burst | uniform | normal
# MARK_BURST_SECONDS=3        # marks land in first N seconds (burst mode)
# LOCUST_RUN_TIME=2m          # mark + throughput tests
# ENABLE_POST_REVIEW=1        # after test: submit to LMS + run deferred review
# REVIEW_POLL_TIMEOUT_SECONDS=180

# ML review benchmark — 100 synthetic marks (same JPEG) → spoof + DINO review timing
# Server must have ENABLE_LOAD_TEST_SEED=true
# ML_REVIEW_MARK_COUNT=100
# ML_REVIEW_POLL_TIMEOUT_SECONDS=600

# Throughput test (same user mix; adds teacher roster/status polling):
# ./load_tests/run_throughput_test.sh
# Reports: throughput_load_test_report.html, throughput_report.html
