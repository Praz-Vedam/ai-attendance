# Copy to load_tests/secrets.env (gitignored)
#
# Minimum: 1 teacher + 1 student access token from your portal login.
# DevTools → Application → Cookies → accessToken

LOAD_TEST_TEACHER_ACCESS_TOKEN=
LOAD_TEST_STUDENT_ACCESS_TOKEN=

# Or refresh tokens (auto-refreshed before each run)
# LOAD_TEST_TEACHER_REFRESH_TOKEN=
# LOAD_TEST_STUDENT_REFRESH_TOKEN=

CLASS_SESSION_ID=3

# Target API (local or hosted)
# LOCUST_HOST=http://127.0.0.1:8000
# LOCUST_HOST=https://attendance.vedam.org

# When testing hosted attendance without local LMS on :9090, set the LMS API
# used by that environment (same tokens as the hosted portals):
# LMS_API_BASE=https://your-lms-api.example.com

# Polling test — replicate 1 student token for N users (default 100)
# LOAD_TEST_STUDENT_TOKEN_COPIES=100

# Mark burst test — 150 users, all spawn immediately, 30s window
# MARK_USERS=150
# MARK_SPAWN_RATE=150
# MARK_RUN_TIME=30s

# Throughput test (100 concurrent, flat — no ramp)
# THROUGHPUT_USERS=100
# THROUGHPUT_SPAWN_RATE=100
# THROUGHPUT_RUN_TIME=5m
