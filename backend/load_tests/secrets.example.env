# Copy to load_tests/secrets.env (gitignored)
#
# Minimum setup: 1 teacher + 1 student token (access or refresh).
# Paste from DevTools → Application → Cookies → localhost
#   accessToken  → LOAD_TEST_*_ACCESS_TOKEN
#   refreshToken → LOAD_TEST_*_REFRESH_TOKEN  (auto-refreshed before each run)
#
# Log into admin portal first, copy teacher token. Then student portal, copy student token.

LOAD_TEST_TEACHER_ACCESS_TOKEN=
LOAD_TEST_STUDENT_ACCESS_TOKEN=

# Or use refresh tokens (refreshed automatically if access token is empty/expired)
# LOAD_TEST_TEACHER_REFRESH_TOKEN=
# LOAD_TEST_STUDENT_REFRESH_TOKEN=

# Class session to simulate (required for mark test)
CLASS_SESSION_ID=12345

# Target server (default local). Use your hosted Python API URL to load-test remote:
# LOCUST_HOST=https://attendance.vedam.org

# Polling test: replicate 1 student token for N concurrent users (default 300)
# LOAD_TEST_STUDENT_TOKEN_COPIES=300

# Mark burst test: concurrent users hitting POST /mark (default 100)
# With 1 student token, only 1 mark succeeds — rest test server/ML under load
# MARK_USERS=100
